{
  "name": "@tummycrypt/scheduling-kit",
  "version": "1.0.0",
  "private": true,
  "description": "Backend-agnostic scheduling components with alternative payment support",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "svelte": "./dist/components/index.js",
      "default": "./dist/components/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "default": "./dist/adapters/index.js"
    },
    "./payments": {
      "types": "./dist/payments/index.d.ts",
      "default": "./dist/payments/index.js"
    },
    "./payments/types": {
      "types": "./dist/payments/types.d.ts",
      "default": "./dist/payments/types.js"
    },
    "./capabilities": {
      "types": "./dist/capabilities/index.d.ts",
      "default": "./dist/capabilities/index.js"
    },
    "./fuzzy": {
      "types": "./dist/fuzzy/index.d.ts",
      "default": "./dist/fuzzy/index.js"
    },
    "./recurrence": {
      "types": "./dist/adapters/recurrence.d.ts",
      "default": "./dist/adapters/recurrence.js"
    },
    "./caldav": {
      "types": "./dist/adapters/caldav-busy.d.ts",
      "default": "./dist/adapters/caldav-busy.js"
    },
    "./availability": {
      "types": "./dist/adapters/availability-substrate.d.ts",
      "default": "./dist/adapters/availability-substrate.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./lib": {
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    },
    "./onboarding": {
      "types": "./dist/onboarding/index.d.ts",
      "default": "./dist/onboarding/index.js"
    },
    "./reconciliation": {
      "types": "./dist/reconciliation/index.d.ts",
      "default": "./dist/reconciliation/index.js"
    },
    "./stores": {
      "types": "./dist/stores/index.d.ts",
      "svelte": "./dist/stores/index.js",
      "default": "./dist/stores/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.map",
    "!dist/tests",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-package -i src",
    "package": "svelte-package -i src",
    "docs:generate": "node scripts/generate-doc-artifacts.mjs",
    "docs:serve": "pnpm docs:generate && mkdocs serve",
    "docs:check": "pnpm docs:generate --check && mkdocs build --strict",
    "check:release-metadata": "node scripts/check-release-metadata.mjs",
    "check:package": "publint",
    "check": "svelte-check --tsgo --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsgo --tsconfig ./tsconfig.json --watch",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:component": "vitest run --config vitest.component.config.ts",
    "test:all": "vitest run && vitest run --config vitest.integration.config.ts && vitest run --config vitest.component.config.ts",
    "test:e2e": "playwright test",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:coverage:report": "vitest run --coverage --reporter=verbose",
    "lint": "eslint .",
    "fixtures:update": "npx tsx scripts/update-fixtures.ts",
    "traces:refresh": "npx tsx scripts/refresh-traces.ts"
  },
  "peerDependencies": {
    "@skeletonlabs/skeleton": "5.0.1",
    "@skeletonlabs/skeleton-svelte": "5.0.1",
    "svelte": "5.57.2"
  },
  "peerDependenciesMeta": {
    "@skeletonlabs/skeleton": {
      "optional": true
    },
    "@skeletonlabs/skeleton-svelte": {
      "optional": true
    }
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "effect": "4.0.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@skeletonlabs/skeleton": "5.0.1",
    "@skeletonlabs/skeleton-svelte": "5.0.1",
    "@sveltejs/package": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.11.0",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitest/coverage-v8": "5.0.3",
    "dotenv": "^16.6.1",
    "eslint": "^9.0.0",
    "eslint-plugin-svelte": "^2.0.0",
    "fast-check": "^3.15.0",
    "jsdom": "^28.0.0",
    "msw": "2.7.0",
    "pg": "^8.13.0",
    "prettier": "^3.0.0",
    "prettier-plugin-svelte": "^3.0.0",
    "publint": "^0.3.25",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "tslib": "^2.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "keywords": [
    "svelte",
    "sveltekit",
    "scheduling",
    "booking",
    "payments",
    "venmo",
    "stripe",
    "acuity",
    "calcom",
    "effect",
    "functional"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xoxd-ai/scheduling-kit.git"
  },
  "pnpm": {
    "patchedDependencies": {
      "svelte-check@4.7.6": "patches/svelte-check@4.7.6.patch"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "msw"
    ]
  },
  "engines": {
    "node": "^22.17.0 || >=24 <25"
  },
  "homepage": "https://github.com/xoxd-ai/scheduling-kit#readme",
  "bugs": {
    "url": "https://github.com/xoxd-ai/scheduling-kit/issues"
  }
}
