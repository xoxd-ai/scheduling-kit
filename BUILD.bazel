"""
BUILD.bazel for @tummycrypt/scheduling-kit.

Two build interfaces: pnpm exposes repository scripts; Bazel owns the hermetic graph.
  Standalone: pnpm build            (svelte-kit sync && svelte-package)
  Bazel:      bazel build //:pkg    (hermetic, cacheable)

Subpackage structure:
  //src/core         - SchedulingAdapter interface, types, Effect wrappers
  //src/adapters     - HomegrownAdapter (PostgreSQL/Drizzle)
  //src/payments     - Stripe, Venmo/PayPal, manual payment adapters
  //src/onboarding   - Payment provider onboarding (credentials, OAuth, webhooks)
  //src/capabilities - Scheduling runtime capability contract + resolver
  //src/components   - 12 Svelte checkout UI components
  //src/stores       - Svelte stores (checkout state)
  //src/lib          - Utilities (URL builder, Acuity listener)
  //src/reconciliation - Alt-payment matching
  //src/testing      - Mock helpers, MSW handlers
"""

load("@aspect_bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library", "js_run_binary")
load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@tummycrypt_scheduling_kit_npm//:defs.bzl", "npm_link_all_packages")
load("@tummycrypt_scheduling_kit_npm//:@sveltejs/kit/package_json.bzl", svelte_kit = "bin")
load("@tummycrypt_scheduling_kit_npm//:svelte-check/package_json.bzl", svelte_check = "bin")
load("@tummycrypt_scheduling_kit_npm//:@sveltejs/package/package_json.bzl", svelte_package = "bin")
load("@tummycrypt_scheduling_kit_npm//:vitest/package_json.bzl", vitest_bin = "bin")

# =============================================================================
# npm link - makes node_modules available
# =============================================================================

npm_link_all_packages(name = "node_modules")

svelte_check.svelte_check_binary(
    name = "svelte_check",
    visibility = ["//visibility:public"],
)

svelte_package.svelte_package_binary(
    name = "svelte_package",
    visibility = ["//visibility:public"],
)

svelte_kit.svelte_kit_binary(
    name = "svelte_kit",
    visibility = ["//visibility:public"],
)

js_binary(
    name = "bazel_svelte_package",
    entry_point = "scripts/svelte-package-bazel-wrapper.mjs",
    data = [
        ":node_modules/@sveltejs/package",
        ":node_modules/svelte",
        ":node_modules/typescript",
    ],
)

# svelte-check and Vitest both read tsconfig.json, which extends the generated
# .svelte-kit/tsconfig.json. Mirror the pnpm scripts' required sync step.
js_run_binary(
    name = "svelte_kit_sync",
    tags = ["manual"],
    tool = ":svelte_kit",
    chdir = ".",
    srcs = glob([
        "src/**/*.ts",
        "src/**/*.svelte",
        "src/**/*.svelte.ts",
    ]) + [
        "package.json",
        "svelte.config.js",
        "tsconfig.json",
        ":node_modules",
    ],
    args = ["sync"],
    out_dirs = [".svelte-kit"],
    visibility = ["//visibility:public"],
)

# =============================================================================
# Svelte package build
#
# Uses svelte-package to compile all src/ to dist/. This handles .svelte
# components, .svelte.ts stores, and plain .ts files in one pass.
# =============================================================================

SCHEDULING_KIT_PACKAGE_SOURCES = glob(
    [
        "src/**/*.ts",
        "src/**/*.svelte",
        "src/**/*.svelte.ts",
    ],
    exclude = [
        "src/**/*.test.ts",
        "src/**/*.spec.ts",
        "src/tests/**",
    ],
)

copy_to_directory(
    name = "scheduling_kit_src",
    srcs = SCHEDULING_KIT_PACKAGE_SOURCES,
    out = "scheduling_kit_src",
    root_paths = ["src"],
)

js_run_binary(
    name = "scheduling_kit_build",
    tags = ["manual"],
    tool = ":bazel_svelte_package",
    srcs = [
        ":scheduling_kit_src",
        "package.json",
        "svelte.config.js",
        "tsconfig.json",
        ":svelte_kit_sync",
        ":node_modules",
    ],
    args = [
        "-i",
        "$(execpath :scheduling_kit_src)",
        "-o",
        "dist",
    ],
    out_dirs = ["dist"],
    visibility = ["//visibility:public"],
)

js_library(
    name = "scheduling_kit",
    srcs = [":scheduling_kit_build"],
    tags = ["manual"],
    # Runtime dependencies (package.json "dependencies") that consumers do not
    # provide themselves. Declaring them here carries their npm package store
    # infos through //:pkg so Bazel consumers that link this module via
    # npm_link_package (e.g. scheduling-bridge) get the dep store entries
    # linked next to the package.
    #
    # `effect` is intentionally NOT linked: consumers declare their own copy
    # and effect values cross the package boundary (e.g. re-exported Errors),
    # so a second linked copy would fork runtime identity (instanceof) and
    # break consumer declaration emit (TS2742) with duplicate type roots.
    # Peer dependencies are likewise excluded; consumers provide them.
    deps = [
        ":node_modules/drizzle-orm",
        ":node_modules/zod",
    ],
    visibility = ["//visibility:public"],
)

# =============================================================================
# JavaScript package artifact
# =============================================================================

npm_package(
    name = "pkg",
    srcs = [
        "package.json",
        "README.md",
        "LICENSE",
        ":scheduling_kit",
    ],
    package = "@tummycrypt/scheduling-kit",
    tags = ["manual"],
    version = "0.11.1",
    visibility = ["//visibility:public"],
)

# =============================================================================
# TypeScript subpackage targets (finer-grained build caching)
#
# These compile individual subpackages independently for:
#   - Incremental builds (only recompile what changed)
#   - Dependency validation (enforce clean boundaries)
#   - Parallel compilation
# =============================================================================

ts_project(
    name = "core",
    srcs = glob(["src/core/**/*.ts"], exclude = ["src/core/**/*.test.ts"]),
    declaration = True,
    tsconfig = ":tsconfig.json",
    transpiler = "tsc",
    validate = False,
    deps = [
        ":node_modules",
        ":node_modules/effect",
        ":node_modules/zod",
    ],
    visibility = ["//visibility:public"],
)

ts_project(
    name = "adapters",
    srcs = glob(["src/adapters/**/*.ts"], exclude = ["src/adapters/**/*.test.ts"]),
    declaration = True,
    tsconfig = ":tsconfig.json",
    transpiler = "tsc",
    validate = False,
    deps = [
        ":core",
        ":node_modules",
        ":node_modules/effect",
        ":node_modules/drizzle-orm",
    ],
    visibility = ["//visibility:public"],
)

ts_project(
    name = "payments",
    srcs = glob(["src/payments/**/*.ts"], exclude = ["src/payments/**/*.test.ts"]),
    declaration = True,
    tsconfig = ":tsconfig.json",
    transpiler = "tsc",
    validate = False,
    deps = [
        ":core",
        ":node_modules",
        ":node_modules/effect",
    ],
    visibility = ["//visibility:public"],
)

ts_project(
    name = "capabilities",
    srcs = glob(["src/capabilities/**/*.ts"], exclude = ["src/capabilities/**/*.test.ts"]),
    declaration = True,
    tsconfig = ":tsconfig.json",
    transpiler = "tsc",
    validate = False,
    deps = [
        ":node_modules",
    ],
    visibility = ["//visibility:public"],
)

ts_project(
    name = "reconciliation",
    srcs = glob(["src/reconciliation/**/*.ts"], exclude = ["src/reconciliation/**/*.test.ts"]),
    declaration = True,
    tsconfig = ":tsconfig.json",
    transpiler = "tsc",
    validate = False,
    deps = [
        ":core",
        ":node_modules",
        ":node_modules/effect",
    ],
    visibility = ["//visibility:public"],
)

ts_project(
    name = "lib",
    srcs = glob(["src/lib/**/*.ts"], exclude = ["src/lib/**/*.test.ts"]),
    declaration = True,
    tsconfig = ":tsconfig.json",
    transpiler = "tsc",
    validate = False,
    deps = [
        ":core",
        ":node_modules",
    ],
    visibility = ["//visibility:public"],
)

ts_project(
    name = "testing_lib",
    srcs = glob(["src/testing/**/*.ts"], exclude = ["src/testing/**/*.test.ts"]),
    declaration = True,
    tsconfig = ":tsconfig.json",
    transpiler = "tsc",
    validate = False,
    deps = [
        ":core",
        ":node_modules",
        ":node_modules/effect",
    ],
    visibility = ["//visibility:public"],
)

ts_project(
    name = "onboarding",
    srcs = glob(["src/onboarding/**/*.ts"], exclude = ["src/onboarding/**/*.test.ts"]),
    declaration = True,
    tsconfig = ":tsconfig.json",
    transpiler = "tsc",
    validate = False,
    deps = [
        ":core",
        ":payments",
        ":node_modules",
        ":node_modules/effect",
    ],
    visibility = ["//visibility:public"],
)

# =============================================================================
# Test targets
# =============================================================================

vitest_bin.vitest_test(
    name = "test",
    tags = ["manual"],
    data = [
        ":node_modules",
        ":svelte_kit_sync",
        "tsconfig.json",
        ":node_modules/vitest",
        "vitest.config.ts",
    ] + glob([
        "src/**/*.ts",
        "src/**/*.svelte",
        "src/**/*.svelte.ts",
    ]),
    args = [
        "run",
        "--reporter=verbose",
        "--config",
        "$(rootpath vitest.config.ts)",
    ],
    log_level = "info",
    visibility = ["//visibility:public"],
)

# The existing rendered-component suite exercises the actual Svelte callbacks.
# Keep it graph-addressable; script-only component results are not Bazel proof.
# This target must be selected by an admitted GF invocation, never run on Neo.
vitest_bin.vitest_test(
    name = "test-component",
    tags = ["manual"],
    data = [
        ":node_modules",
        ":svelte_kit_sync",
        "package.json",
        "svelte.config.js",
        "tsconfig.json",
        "vitest.component.config.ts",
    ] + glob([
        "src/**/*.ts",
        "src/**/*.svelte",
        "tests/e2e/**/*.ts",
    ]),
    args = [
        "run",
        "--reporter=verbose",
        "--config",
        "$(rootpath vitest.component.config.ts)",
    ],
    log_level = "info",
    visibility = ["//visibility:public"],
)

# =============================================================================
# Typecheck (svelte-check)
# =============================================================================

js_run_binary(
    name = "typecheck",
    tags = ["manual"],
    tool = ":svelte_check",
    chdir = ".",
    srcs = glob(
        [
            "src/**/*.ts",
            "src/**/*.svelte",
            "src/**/*.svelte.ts",
        ],
        allow_empty = True,
    ) + [
        "svelte.config.js",
        "tsconfig.json",
        ":svelte_kit_sync",
        ":node_modules",
    ],
    args = [
        "--tsconfig",
        "$(rootpath tsconfig.json)",
    ],
    stdout = "typecheck.log",
    visibility = ["//visibility:public"],
)

# =============================================================================
# Exported files
# =============================================================================

exports_files(
    [
        ".npmrc",
        "package.json",
        "svelte.config.js",
        "tsconfig.json",
        "vitest.config.ts",
    ],
    visibility = ["//visibility:public"],
)
